		"mini-css-extract-plugin": "^2.8.1",
		"resolve-url-loader": "^5.0.0",
		"vue-loader": "^17.4.2",
		"webpack": "^5.91.0",
		"webpack-cli": "^5.1.4"
	},
	"dependencies": {
		"axios": "^1.7.5",
		"datatables.net-dt": "^2.1.4",
		"vue": "^3.4.21",
		"vue-router": "^4.3.0"
	}
